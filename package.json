{
  "name": "postgrad-study-mcp",
  "version": "0.1.0",
  "description": "MCP server para estudos da pós: busca em anotações, código e PDFs das aulas, dúvidas e progresso",
  "main": "dist/index.js",
  "bin": {
    "postgrad-study-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --inspect src/index.ts",
    "test": "node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "mcp:inspect": "npx @modelcontextprotocol/inspector -e NOTES_DIR=./tests/fixtures/notas node src/index.ts",
    "test:dev": "node --inspect --test --watch tests/**/*.test.ts",
    "test:semantic": "node --test --test-concurrency=1 tests/*.model.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:pack": "node --test tests/pacote.smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "estudos",
    "pos-graduacao",
    "copilot"
  ],
  "author": "Vinicius Wasinski",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasinskivini/postgrad-study-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wasinskivini/postgrad-study-mcp/issues"
  },
  "homepage": "https://github.com/wasinskivini/postgrad-study-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/node": "^24.11.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
