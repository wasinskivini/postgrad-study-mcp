{
  "name": "study-notes-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP de estudos: busca nas suas anotações, PDFs e código com fonte citada, busca por significado local, dúvidas, progresso e quizzes",
  "main": "dist/index.js",
  "bin": {
    "study-notes-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --inspect src/index.ts",
    "test": "node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "mcp:inspect": "npx @modelcontextprotocol/inspector -e NOTES_DIR=./tests/fixtures/notas node src/index.ts",
    "test:dev": "node --inspect --test --watch tests/**/*.test.ts",
    "test:semantic": "node --test --test-concurrency=1 tests/*.model.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:pack": "node --test tests/pacote.smoke.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "estudos",
    "study-notes",
    "notes",
    "obsidian",
    "pdf",
    "semantic-search",
    "rag",
    "copilot",
    "claude",
    "codex"
  ],
  "author": "Vinicius Wasinski",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasinskivini/study-notes-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wasinskivini/study-notes-mcp/issues"
  },
  "homepage": "https://github.com/wasinskivini/study-notes-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
