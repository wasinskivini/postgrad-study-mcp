# Variáveis de configuração do postgrad-study-mcp.
# Nenhuma delas é credencial: o servidor não usa chaves de API nem acessa a internet
# (exceto, com SEMANTIC_SEARCH=true, para baixar uma vez o modelo de embeddings).
#
# O servidor NÃO lê este arquivo sozinho:
#   - No VS Code, coloque os valores no bloco "env" do servidor no mcp.json (veja o README).
#   - Para rodar pelo terminal, copie para .env e use: node --env-file=.env src/index.ts

# Pasta raiz do seu material de estudos (obrigatório na prática; padrão: ~/Documents).
# Use caminho absoluto. Cada subpasta de primeiro nível vira um módulo.
NOTES_DIR=/caminho/absoluto/da/sua/pasta/de/estudos

# Onde ficam duvidas.json e progresso.json (opcional; padrão: ~/.postgrad-study-mcp).
# DATA_DIR=/caminho/absoluto/para/os/dados

# "false" desliga a busca e a leitura de PDFs (opcional; padrão: true).
INCLUDE_PDF=true

# "true" liga a busca por significado com embeddings (opcional; padrão: false).
# Na primeira vez baixa um modelo de ~145 MB e indexa anotações e PDFs em segundo plano.
# SEMANTIC_SEARCH=true

# Onde o modelo de embeddings fica guardado (opcional; padrão: DATA_DIR/modelos).
# MODELS_DIR=/caminho/absoluto/para/os/modelos
